{
  "name": "@domus/api",
  "version": "0.1.0",
  "description": "API REST del sistema Domus IA: proyectos, versiones, instrucciones, catálogo, documentos y auditoría.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "migrate": "node dist/scripts/migrate.js",
    "seed": "node dist/scripts/seed.js",
    "e2e": "node dist/scripts/e2e.js",
    "test": "node -e \"console.log('Las pruebas de la API se ejecutan con pnpm e2e (requiere build previo).')\""
  },
  "dependencies": {
    "@domus/assistant": "workspace:*",
    "@domus/domain": "workspace:*",
    "@electric-sql/pglite": "^0.2.17",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pdfkit": "^0.15.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.13.5",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
