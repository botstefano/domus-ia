# ---------------------------------------------------------------------------
# Domus IA - variables de entorno de ejemplo.
# Copie este archivo a .env y ajuste los valores. NUNCA suba credenciales reales.
# ---------------------------------------------------------------------------

# Puerto de la API
PORT=3000

# Origen permitido para CORS (interfaz web en desarrollo)
WEB_ORIGIN=http://localhost:5173

# Base de datos: "pglite" (PostgreSQL embebido, sin servicios externos) o "postgres"
DB_DRIVER=pglite
DATABASE_URL=postgresql://domus:domus@localhost:5432/domus?schema=public
PGLITE_DIR=data/pglite

# Seguridad: cambie esta clave en cualquier entorno real
JWT_SECRET=cambie-esta-clave-por-una-aleatoria-de-64-caracteres
JWT_EXPIRES_IN=8h

# Modelo de lenguaje (opcional). Sin LLM_API_KEY el sistema funciona en modo reglas.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=20000

# Almacenamiento de documentos (previsto para S3/MinIO; el MVP los genera en memoria)
STORAGE_DIR=data/documents

# Interfaz web: URL de la API cuando no se usa el proxy de Vite
VITE_API_URL=/api
